{
  "name": "mobile-scoring-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --config firebase.rules-test.json --only firestore --project demo-tac-rules \"vitest run --config vitest.rules.config.ts\"",
    "dev:cloud": "npx -y firebase-tools@13 emulators:exec --only auth,firestore --project demo-tac-scoring \"vite --mode emulator\"",
    "scores:export": "tsx scripts/scores.ts export",
    "scores:clear": "tsx scripts/scores.ts clear",
    "competition:reset": "tsx scripts/scores.ts reset",
    "competition:upload": "tsx scripts/upload.ts"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
